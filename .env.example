# Restaurant POS Environment Configuration
# This application is offline-first and requires minimal configuration.

# Database path (defaults to app data directory if not set)
# DATABASE_PATH=./data/restaurant.db

# Backup directory (defaults to app data directory if not set)
# BACKUP_DIR=./backups

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Server port for multi-terminal support (default: 3847)
# SERVER_PORT=3847
